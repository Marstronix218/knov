# Copy to .env.local (git-ignored). Development builds (`npm run dev:desktop`)
# read it at startup; release builds never do, so a key cannot ship in the app.
# Variables already set in your shell take precedence.

# --- Knov-provided AI ---------------------------------------------------------
# Simulates "Knov provides the AI": users skip the AI step in onboarding and
# never see a key. In production this moves to a server-side proxy instead.
KNOV_MANAGED_PROVIDER=openai
OPENAI_API_KEY=
# Optional: override the OpenAI model Knov requests.
# KNOV_OPENAI_MODEL=

# --- Cost estimates (Settings → AI usage & cost) --------------------------------
# USD per million tokens for the model above. Copy current prices from your
# provider's pricing page; the provider's billing dashboard stays the source of truth.
# KNOV_INPUT_COST_PER_MILLION=
# KNOV_OUTPUT_COST_PER_MILLION=
# KNOV_CACHE_READ_COST_PER_MILLION=
